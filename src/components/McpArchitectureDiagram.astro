---
const ICONS = {
  laptop:
    '<path d="M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z"/>',
  puzzle:
    '<path d="M17 22H5a3 3 0 0 1-3-3V9a3 3 0 0 1 3-3h1a4 4 0 0 1 7.3-2.18c.448.64.692 1.4.7 2.18h3a1 1 0 0 1 1 1v3a4 4 0 0 1 2.18 7.3A3.86 3.86 0 0 1 18 18v3a1 1 0 0 1-1 1ZM5 8a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11v-3.18a1 1 0 0 1 1.33-.95 1.77 1.77 0 0 0 1.74-.23 2 2 0 0 0 .93-1.37 2 2 0 0 0-.48-1.59 1.89 1.89 0 0 0-2.17-.55 1 1 0 0 1-1.33-.95V8h-3.2a1 1 0 0 1-1-1.33 1.77 1.77 0 0 0-.23-1.74 1.939 1.939 0 0 0-3-.43A2 2 0 0 0 8 6c.002.23.046.456.13.67A1 1 0 0 1 7.18 8H5Z"/>',
  'open-book':
    '<path d="M21.17 2.06A13.1 13.1 0 0 0 19 1.87a12.94 12.94 0 0 0-7 2.05 12.94 12.94 0 0 0-7-2 13.1 13.1 0 0 0-2.17.19 1 1 0 0 0-.83 1v12a1 1 0 0 0 1.17 1 10.9 10.9 0 0 1 8.25 1.91l.12.07h.11a.91.91 0 0 0 .7 0h.11l.12-.07A10.899 10.899 0 0 1 20.83 16 1 1 0 0 0 22 15V3a1 1 0 0 0-.83-.94ZM11 15.35a12.87 12.87 0 0 0-6-1.48H4v-10c.333-.02.667-.02 1 0a10.86 10.86 0 0 1 6 1.8v9.68Zm9-1.44h-1a12.87 12.87 0 0 0-6 1.48V5.67a10.86 10.86 0 0 1 6-1.8c.333-.02.667-.02 1 0v10.04Zm1.17 4.15a13.098 13.098 0 0 0-2.17-.19 12.94 12.94 0 0 0-7 2.05 12.94 12.94 0 0 0-7-2.05c-.727.003-1.453.066-2.17.19A1 1 0 0 0 2 19.21a1 1 0 0 0 1.17.79 10.9 10.9 0 0 1 8.25 1.91 1 1 0 0 0 1.16 0A10.9 10.9 0 0 1 20.83 20a1 1 0 0 0 1.17-.79 1 1 0 0 0-.83-1.15Z"/>',
};

const nodes = [
  {
    icon: 'laptop',
    title: 'Your AI Client',
    subtitle: 'Claude Code · Claude Desktop · Cursor · ChatGPT',
  },
  {
    icon: 'puzzle',
    title: 'Taskip MCP Server',
    subtitle: null,
  },
  {
    icon: 'open-book',
    title: 'Your Taskip Workspace',
    subtitle: 'Clients · Projects · Invoices · Pipeline · Inbox · and more',
  },
];

const connectors = [
  'MCP Protocol, over a secure connection token',
  'Scoped to your workspace',
];
---

<div class="mcp-flow" role="img" aria-label={`${nodes[0].title} connects through ${nodes[1].title} to ${nodes[2].title}`}>
  {nodes.map((node, i) => (
    <>
      <div class="mcp-flow__node">
        <span class="mcp-flow__icon" set:html={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor">${ICONS[node.icon]}</svg>`} />
        <span class="mcp-flow__text">
          <span class="mcp-flow__title">{node.title}</span>
          {node.subtitle && <span class="mcp-flow__subtitle">{node.subtitle}</span>}
        </span>
      </div>
      {i < connectors.length && (
        <div class="mcp-flow__connector">
          <span class="mcp-flow__line" aria-hidden="true"></span>
          <span class="mcp-flow__label">{connectors[i]}</span>
        </div>
      )}
    </>
  ))}
</div>

<style>
  .mcp-flow {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin: 1.5rem 0;
    padding: 1.5rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--sl-color-accent) 5%, var(--sl-color-bg));
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
  }

  .mcp-flow__node {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    border-radius: 8px;
    background: var(--sl-color-bg);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 25%, transparent);
  }

  .mcp-flow__icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  .mcp-flow__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .mcp-flow__title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--sl-color-text);
  }

  .mcp-flow__subtitle {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }

  .mcp-flow__connector {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding-left: calc(2.25rem / 2 + 1.1rem);
  }

  .mcp-flow__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(2.25rem / 2 + 1.1rem);
    width: 2px;
    background: color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
  }

  .mcp-flow__line::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
  }

  .mcp-flow__label {
    position: relative;
    font-size: 0.75rem;
    color: var(--sl-color-gray-2);
    background: color-mix(in srgb, var(--sl-color-accent) 5%, var(--sl-color-bg));
    padding: 0.15rem 0.6rem;
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .mcp-flow {
      padding: 1rem;
    }
    .mcp-flow__node {
      padding: 0.7rem 0.85rem;
    }
    .mcp-flow__subtitle {
      font-size: 0.75rem;
    }
  }
</style>
