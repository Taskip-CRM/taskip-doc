# ── Keystatic GitHub OAuth (required for CMS login) ──────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL: https://docs.taskip.net
# Callback URL:  https://docs.taskip.net/api/keystatic/github/oauth/callback

KEYSTATIC_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# A random 32-char secret (run: openssl rand -hex 16)
KEYSTATIC_SECRET=your_random_secret_here

# Your GitHub repo where docs content lives
# Format: owner/repo-name
GITHUB_REPO_OWNER=taskip
GITHUB_REPO_NAME=docs

# ── Public site URL ──────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://docs.taskip.net
