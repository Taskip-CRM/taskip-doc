---
import KeystaticPage from '@keystatic/astro/internal/keystatic-astro-page.astro';
export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Taskip Docs — CMS</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --brand: #00B289;
        --brand-dim: #008f6e;
        --brand-glow: rgba(0, 178, 137, 0.18);
        --bg: #09100e;
        --bg-card: rgba(255,255,255,0.03);
        --border: rgba(0, 178, 137, 0.15);
        --text: #e8f5f1;
        --text-muted: rgba(232,245,241,0.45);
      }

      html, body {
        height: 100%;
        background: var(--bg);
        font-family: 'Sora', system-ui, sans-serif;
        color: var(--text);
        overflow-x: hidden;
      }

      /* ── Geometric background grid ── */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image:
          linear-gradient(rgba(0,178,137,0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(0,178,137,0.04) 1px, transparent 1px);
        background-size: 48px 48px;
        pointer-events: none;
        z-index: 0;
      }

      /* ── Ambient glow orb ── */
      .ks-glow {
        position: fixed;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(0,178,137,0.12) 0%, transparent 70%);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -60%);
        pointer-events: none;
        z-index: 0;
        animation: pulse 6s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 0.7; transform: translate(-50%, -60%) scale(1); }
        50%       { opacity: 1;   transform: translate(-50%, -60%) scale(1.08); }
      }

      /* ── Corner accent lines ── */
      .ks-corner {
        position: fixed;
        width: 120px;
        height: 120px;
        pointer-events: none;
        z-index: 1;
      }
      .ks-corner--tl { top: 24px; left: 24px; border-top: 1px solid var(--brand); border-left: 1px solid var(--brand); opacity: 0.4; }
      .ks-corner--br { bottom: 24px; right: 24px; border-bottom: 1px solid var(--brand); border-right: 1px solid var(--brand); opacity: 0.4; }


      /* ── Loading skeleton (shows before React hydrates) ── */
      .ks-loading {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 24px;
        z-index: 5;
        opacity: 1;
        transition: opacity 0.3s ease;
      }

      .ks-loading.hidden { opacity: 0; pointer-events: none; }

      .ks-loading-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--brand), var(--brand-dim));
        display: flex;
        align-items: center;
        justify-content: center;
        animation: spin-fade 2s ease-in-out infinite;
      }

      @keyframes spin-fade {
        0%, 100% { box-shadow: 0 0 0 0 var(--brand-glow); }
        50%       { box-shadow: 0 0 32px 8px var(--brand-glow); }
      }

      .ks-loading-dots {
        display: flex;
        gap: 8px;
      }

      .ks-loading-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--brand);
        opacity: 0.3;
        animation: dot-pulse 1.4s ease-in-out infinite;
      }
      .ks-loading-dot:nth-child(2) { animation-delay: 0.2s; }
      .ks-loading-dot:nth-child(3) { animation-delay: 0.4s; }

      @keyframes dot-pulse {
        0%, 80%, 100% { opacity: 0.3; transform: scale(1); }
        40%            { opacity: 1;   transform: scale(1.3); }
      }

      /* ── Keystatic app wrapper ── */
      #keystatic-wrapper {
        position: relative;
        z-index: 2;
        min-height: 100vh;
      }

      /* ── Override Keystatic login button area ── */
      /* Target the flex container keystatic renders for the login screen */
      #keystatic-wrapper > div[style*="height: 100vh"],
      #keystatic-wrapper > div[style*="height:100vh"] {
        background: transparent !important;
      }

      /* Style the GitHub login button rendered by keystatic */
      #keystatic-wrapper a[href*="keystatic/github/login"],
      #keystatic-wrapper button {
        background: var(--brand) !important;
        color: #fff !important;
        border: none !important;
        border-radius: 10px !important;
        padding: 14px 28px !important;
        font-family: 'Sora', sans-serif !important;
        font-size: 15px !important;
        font-weight: 600 !important;
        letter-spacing: -0.01em !important;
        cursor: pointer !important;
        box-shadow: 0 0 0 1px rgba(0,178,137,0.4), 0 8px 32px rgba(0,178,137,0.3) !important;
        transition: transform 0.15s ease, box-shadow 0.15s ease !important;
        text-decoration: none !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 10px !important;
      }

      #keystatic-wrapper a[href*="keystatic/github/login"]:hover,
      #keystatic-wrapper button:hover {
        transform: translateY(-2px) !important;
        box-shadow: 0 0 0 1px rgba(0,178,137,0.6), 0 12px 40px rgba(0,178,137,0.4) !important;
      }

      /* Card backdrop behind the login button */
      #keystatic-wrapper > div[style*="height"] {
        position: relative;
      }

      /* Footer version text */
      .ks-footer {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        color: var(--text-muted);
        letter-spacing: 0.06em;
        z-index: 10;
        white-space: nowrap;
      }

      .ks-footer span {
        color: var(--brand);
        opacity: 0.7;
      }
    </style>
  </head>
  <body>
    <!-- Ambient effects -->
    <div class="ks-glow" aria-hidden="true"></div>
    <div class="ks-corner ks-corner--tl" aria-hidden="true"></div>
    <div class="ks-corner ks-corner--br" aria-hidden="true"></div>

    <!-- Loading state (hidden once React hydrates) -->
    <div class="ks-loading" id="ks-loading">
      <div class="ks-loading-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="ks-loading-dots">
        <div class="ks-loading-dot"></div>
        <div class="ks-loading-dot"></div>
        <div class="ks-loading-dot"></div>
      </div>
    </div>

    <!-- Keystatic React app -->
    <div id="keystatic-wrapper">
      <KeystaticPage />
    </div>

    <!-- Footer -->
    <footer class="ks-footer">
      Taskip Docs &nbsp;<span>·</span>&nbsp; Content Management
    </footer>

    <script>
      // Hide loading overlay once Keystatic's React app has rendered
      const wrapper = document.getElementById('keystatic-wrapper');
      const loading = document.getElementById('ks-loading');
      if (wrapper && loading) {
        const observer = new MutationObserver(() => {
          if (wrapper.children.length > 0) {
            loading.classList.add('hidden');
            observer.disconnect();
          }
        });
        observer.observe(wrapper, { childList: true, subtree: true });
        // Fallback: hide after 4s regardless
        setTimeout(() => loading.classList.add('hidden'), 4000);
      }
    </script>
  </body>
</html>
